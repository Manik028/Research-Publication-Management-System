# ---------------------------------------------------------------
# RPMS Backend environment configuration
# Copy this file to config/.env and fill in your own values.
# ---------------------------------------------------------------

# HTTP port the Express server listens on.
PORT=5000

# ---- Oracle Database -------------------------------------------
# The schema user that owns the RPMS tables.
DB_USER=rpms_user
DB_PASSWORD=change_me

# easy-connect string: host:port/service_name
# Examples:
#   localhost:1521/orcl
#   localhost:1521/XEPDB1      (Oracle XE 18c/21c pluggable DB)
#   localhost:1521/FREEPDB1    (Oracle Database 23ai Free)
DB_CONNECTION_STRING=localhost:1521/orcl

# Connection pool sizing (optional).
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=2

# Only set this if you need node-oracledb Thick mode (Oracle DB 11.2 or older).
# Point it at your Instant Client directory, e.g.
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_13
# ORACLE_CLIENT_LIB_DIR=

# ---- Authentication --------------------------------------------
# Use a long random string in production.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- CORS ------------------------------------------------------
# Use * for local development, or the exact frontend origin in production.
CORS_ORIGIN=*

# ---- Email (password reset + 2FA OTPs) --------------------------
# Optional. If SMTP_HOST is left unset, emailService.js prints the OTP to
# the backend console instead of sending a real email — fine for local
# testing, but set these for anything that matters.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# EMAIL_FROM=RPMS <no-reply@yourdomain.com>
