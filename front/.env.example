# ---------------------------------------------------------------
# Frontend environment configuration (Vite)
# Copy this file to .env if you need to override the defaults.
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------

# Where the API lives.
#
# Leave this EMPTY for local development: requests go to a relative
# /api/... path and vite.config.js proxies them to the backend, which
# avoids CORS entirely.
#
# Set it to an absolute origin only when the frontend is deployed
# separately from the API, e.g.
#   VITE_API_BASE_URL=https://rpms-api.example.com
VITE_API_BASE_URL=

# Port the Vite dev server binds to (defaults to 5173).
# VITE_PORT=5173

# Where the dev proxy forwards /api requests (defaults to http://localhost:5000).
# Change this if you run the backend on a different port.
# VITE_PROXY_TARGET=http://localhost:5000
